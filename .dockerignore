.git
.gitignore
.env
.env.*
!.env.example
node_modules
vendor
# Package-discovery cache generated by a local (dev-dependency-inclusive) composer install —
# must be regenerated inside the image against the --no-dev vendor tree, or booting the app
# fails looking for dev-only providers (e.g. Laravel\Pail) that aren't in the image's vendor/.
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/debugbar
public/build
public/hot
public/storage
tests
.phpunit.cache
phpunit.xml
docker-compose*.yml
Dockerfile
.dockerignore
