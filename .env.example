APP_NAME="Rechtspraak Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the supported database driver (full-text search + jsonb columns).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rechtspraak_portal
DB_USERNAME=rechtspraak_portal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Feed fetching and LLM calls run on the Redis queue so they never block requests.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: use Mailtrap in local/staging, Postmark in production. Only these values change between
# environments — no code change is required to switch (see config/mail.php + README).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="rechtspraak-portal@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=postmark and provide this token in production.
POSTMARK_TOKEN=

# Hour (0-23, server time) at which daily/weekly rulings digests are sent.
DIGEST_SEND_HOUR=8

# Credentials for the initial admin account created by AdminUserSeeder (php artisan db:seed).
# Change the password immediately after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Which provider/model is used for which task (classification vs summarization) is configured
# at RUNTIME via the `llm_task_configs` database table (seeded with sensible defaults, editable
# without a redeploy). The variables below hold ONLY the provider secrets/endpoints, which stay
# in .env since they are per-environment infrastructure, not business configuration.

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Under `docker compose`, Ollama runs as its own bundled service and app/worker/scheduler
# override this to http://ollama:11434 (see docker-compose.yml). This value is for plain
# `php artisan serve` local dev, where Ollama is reached via its published host port instead.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Coolify
# ---------------------------------------------------------------------------
# Coolify injects environment variables at deploy time via its own env-management UI; no
# secrets are baked into the Docker image. APP_URL above should be set to the public domain
# Coolify assigns/proxies to this service.
